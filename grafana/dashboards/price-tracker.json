  {
   "id": 9,
   "type": "timeseries",
   "title": "Source failures per 5 min, by error type",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 17,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source, error) (increase(price_tracker_source_failures_total[5m]))",
     "legendFormat": "{{source}} / {{error}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "type": "stat",
   "title": "Circuit breaker (OPEN = source quarantined)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 25,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "price_tracker_source_circuit_open",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "closed",
         "color": "green"
        },
        "1": {
         "text": "OPEN",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "graphMode": "none",
    "textMode": "auto",
    "colorMode": "background"
   }
  },
  {
   "id": 11,
   "type": "stat",
   "title": "Dropped as outlier (last hour)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 25,
    "w": 12,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (source) (increase(price_tracker_source_outliers_total[1h]))",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
